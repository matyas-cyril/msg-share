auth_mechanisms {
  oauthbearer = yes
  xoauth2 = yes
}

oauth2 {
  introspection_mode = post
  # tokeninfo_url = https://keycloak.example.com:8443/realms/example.com/protocol/openid-connect/userinfo?tokentoverify=
  # introspection_url = https://keycloak.example.com:8443/realms/example.com/protocol/openid-connect/userinfo
  introspection_url = https://roundcube:S9CC8kyju55sUvIv6g1zaa30eNPyjx0k@keycloak.example.com:8443/realms/example.com/protocol/openid-connect/token/introspect
  # Pas secure
  username_attribute = email
  active_attribute = active
  active_value = true
  # client_id = dovecot
  # client_secret = mRS9euVEkl1wulsXU3JQPjQHrHPdDTUHa
}


passdb static {
  fields {
      # user = %{u}
      proxy=y
      # nopassword=y
      host=frontend01
      port=143
      proxy_mech=plain
      master=cyrus
      pass=Cyrus
     }
 }
